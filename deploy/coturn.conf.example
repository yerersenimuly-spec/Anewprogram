listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_RANDOM_SECRET
realm=turn.example.org
server-name=turn.example.org
cert=/path/to/fullchain.pem
pkey=/path/to/privkey.pem
min-port=49160
max-port=49200
no-multicast-peers
no-cli
no-loopback-peers
# If the TURN host is behind NAT: external-ip=PUBLIC_IP/PRIVATE_IP
# Restrict private peer IP ranges to prevent relay access to internal services.
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
